# Copy this file to ".env" and fill in your own values.

# Port the server listens on
PORT=3000

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Comma-separated list of emails that should automatically become admins
# the moment they sign up (e.g. the IT & Web Development team leads).
ADMIN_EMAILS=leader@example.com,itlead@example.com

# Set to "production" when deploying behind HTTPS (makes cookies "secure").
NODE_ENV=development
